# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Translation Provider Strategy
# Options: 'mymemory' (default zero-config), 'google', 'azure', 'libretranslate'
TRANSLATION_PROVIDER=mymemory

# Google Cloud Translation API Configuration (Optional)
GOOGLE_TRANSLATE_API_KEY=

# Microsoft Azure Translator Configuration (Optional)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global

# LibreTranslate Configuration (Optional)
LIBRETRANSLATE_API_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
