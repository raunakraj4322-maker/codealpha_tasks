{
  "name": "codealpha-language-translation-tool",
  "version": "1.0.0",
  "description": "Full-Stack AI Language Translation Tool created for CodeAlpha Internship",
  "main": "backend/dist/server.js",
  "scripts": {
    "setup": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm run start --prefix backend"
  },
  "keywords": [
    "translation",
    "ai",
    "fullstack",
    "codealpha",
    "express",
    "react",
    "typescript",
    "tailwind"
  ],
  "author": "CodeAlpha Intern",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
